+++ b/billing/digest.py
@@ -0,0 +1,19 @@
+from collections import defaultdict
+
+from billing.models import Invoice
+
+
+def build_overdue_digest(today):
+    """Group open, overdue invoices by billing-contact email for the nightly digest."""
+    overdue = Invoice.objects.filter(status="open", due_date__lt=today).order_by("due_date")
+    digest = defaultdict(list)
+    for invoice in overdue:
+        email = invoice.customer.billing_contact.email.lower()
+        digest[email].append(
+            {
+                "number": invoice.number,
+                "amount_due": str(invoice.amount_due),
+                "days_overdue": (today - invoice.due_date).days,
+            }
+        )
+    return dict(digest)
